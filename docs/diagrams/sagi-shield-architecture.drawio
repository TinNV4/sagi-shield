    <mxCell id="title" value="Sagi Shield · architecture (all Google Cloud, one deployable service)" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#202124;" vertex="1" parent="1">
      <mxGeometry x="40" y="16" width="900" height="40" as="geometry"/>
    </mxCell>

    <mxCell id="home" value="HOME · browser PWA, no install, no audio upload" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#4285F4;strokeWidth=2;verticalAlign=top;fontSize=14;fontStyle=1;fontColor=#174EA6;spacingTop=6;arcSize=4;" vertex="1" parent="1">
      <mxGeometry x="40" y="80" width="400" height="760" as="geometry"/>
    </mxCell>
    <mxCell id="tablet" value="&lt;b&gt;Senior&#39;s tablet or phone · Live Guard kiosk&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5F6368&quot;&gt;on-device speech recognition (Web Speech API)&lt;br&gt;number masking before anything is sent&lt;br&gt;risk meter · full-screen takeover · spoken alert&lt;br&gt;Quick Check: text, screenshot, link, phone, recording&lt;br&gt;振込前チェック pre-transfer check&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4285F4;fontSize=13;fontColor=#202124;align=left;spacingLeft=12;arcSize=8;" vertex="1" parent="1">
      <mxGeometry x="70" y="130" width="340" height="150" as="geometry"/>
    </mxCell>
    <mxCell id="guardian" value="&lt;b&gt;Guardian phone · same PWA&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5F6368&quot;&gt;paired by QR or 6-digit code&lt;br&gt;receives one sentence and the stage, never the transcript&lt;br&gt;call-back on a saved number&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4285F4;fontSize=13;fontColor=#202124;align=left;spacingLeft=12;arcSize=8;" vertex="1" parent="1">
