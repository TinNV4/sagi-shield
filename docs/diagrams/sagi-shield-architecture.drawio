    <mxCell id="run" value="CLOUD RUN · asia-northeast1 · one service, one URL (API + built PWA)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F4EA;strokeColor=#34A853;strokeWidth=2;verticalAlign=top;fontSize=14;fontStyle=1;fontColor=#0D652D;spacingTop=6;arcSize=4;" vertex="1" parent="1">
