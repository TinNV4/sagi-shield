GOOGLE_CLOUD_PROJECT=your-project-id
# Gemini 3.8 Flash is served from the global endpoint on Agent Platform (formerly Vertex AI);
# Cloud Run / Firestore stay in asia-northeast1
GOOGLE_CLOUD_LOCATION=global
# google-genai >= 2.x name; GOOGLE_GENAI_USE_VERTEXAI is still read as a legacy alias
GOOGLE_GENAI_USE_ENTERPRISE=true
# quick local test alternative: GEMINI_API_KEY=...
GEMINI_MODEL=gemini-3.8-flash
# streaming STT: set after the P0.5 bake-off (gemini-3.5-transcribe-live | chirp_3)
STT_BACKEND=gemini-3.5-transcribe-live
# HMAC key for phone numbers (Secret Manager in production)
HASH_KEY=change-me
