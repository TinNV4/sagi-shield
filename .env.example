# Copy to .env at the repo root (loaded automatically by backend/core/* and backend/app/*). Every variable the backend
# reads is listed here with its default; leave a line out to keep the default. Secrets go to Secret Manager on Cloud Run.

# --- Google Cloud / Gemini ---
GOOGLE_CLOUD_PROJECT=your-project-id
# Gemini 3.x is served from the global endpoint on Agent Platform (formerly Vertex AI); Cloud Run / Firestore stay in asia-northeast1
GOOGLE_CLOUD_LOCATION=global
# google-genai >= 2.x name (GOOGLE_GENAI_USE_VERTEXAI is still read as a legacy alias). With an API key this must be false.
GOOGLE_GENAI_USE_ENTERPRISE=true
# Quick local alternative to Agent Platform: a Gemini Developer API key (then GOOGLE_GENAI_USE_ENTERPRISE=false)
# GEMINI_API_KEY=

# --- Models: one place, backend/core/model_ids.py, holds the defaults (= what Cloud Run runs). Override per job here. ---
# GEMINI_MODEL=gemini-3.5-flash-lite        # text judge, recovery agent, dataset generation
# GEMINI_LIVE_MODEL=gemini-3.5-flash-lite   # Live Guard judge
# GEMINI_CONFIRM_MODEL=gemini-3.8-flash     # second opinion before an alarm the rules cannot back
# GEMINI_VISION_MODEL=gemini-3.8-flash      # screenshots / documents
# GEMINI_DEEP_MODEL=                        # opt-in Google-Search deep check (unset -> GEMINI_CONFIRM_MODEL)
# STT_BATCH_MODEL=gemini-3.5-transcribe     # uploaded recordings

# --- Uploaded-recording transcription (Live Guard never uploads audio: STT runs in the browser) ---
# gemini-3.5-transcribe is served by the Gemini Developer API only: a key for it (secret sagi-stt-api-key on Cloud Run,
# infra/setup_stt_key.ps1). Without it the chain falls through to the scoring model, then Chirp 3 (Speech-to-Text v2).
# STT_API_KEY=
# STT_LOCATIONS=us-central1,asia-northeast1,us,europe-west4   # Agent Platform locations probed for the transcribe model
# CHIRP_REGION=us                                             # chirp_3 is served from the us / eu multi-regions only

# --- Privacy ---
# HMAC key for phone numbers (Secret Manager in production; STORE=firestore refuses to start with the dev default)
HASH_KEY=change-me

# --- API switches (backend/app) ---
# USE_LLM=1               # 0 = rules only, no network (what the tests run with)
# USE_WEBRISK=0           # 1 = look up URLs in Web Risk
# STORE=memory            # firestore on Cloud Run
# CORS_ORIGINS=*          # comma-separated origins; the PWA is served from the same origin on Cloud Run
# RATE_LIMIT_PER_MIN=30   # per client; 0 = off
# AUTH=firebase           # fake = local dev with STORE=memory: tokens "fake:<uid>:<anonymous|google.com|phone>[:admin]"; off = everyone is a nameless device. Both refused with STORE=firestore
# LEGACY_FAMILY=1         # 0 = the shared-secret /family/* routes answer 410 (deleted for good on 2026-11-14)
# BQ_TABLE=               # project.dataset.table for the anonymous event stream (app/analytics.py); unset = off

# --- Live Guard (app/live.py) ---
# LIVE_LLM_GATE=periodic  # periodic = masked window to Gemini on a clock; rules = only once the rules reach MEDIUM
# LIVE_PERIODIC_S=20      # seconds between periodic looks
# LIVE_PERIODIC_LINES=6   # ... or this many unseen lines, whichever comes first
# LIVE_LLM_EVERY_S=5      # minimum spacing between looks triggered by rule hits
# LIVE_SILENCE_S=45       # silence that ends a call (LiveTracker.reset)
# LIVE_CONTEXT=on         # off = the judge reads the bare window without the <call_state> block (A/B runs only)

# --- Verdict log: why each check / live look ended where it did (app/verdict_log.py) ---
# Stdout JSON always (Cloud Logging); VERDICT_LOG=<path> also appends JSONL for local runs; LOG_TEXT=1 adds the masked
# text - local evaluation only, never on Cloud Run. Tests run with VERDICT_STDOUT=0.
# VERDICT_LOG=backend/eval/logs/local.jsonl
# LOG_TEXT=0

# --- Model comparison only (tools/compare_llm.py). The product and the contest entry stay on Gemini. ---
# LLM_BACKEND=fci sends the (masked) text to an OpenAI-compatible endpoint instead of Gemini. Never deploy with fci.
LLM_BACKEND=gemini
OPENAI_API_KEY=
OPENAI_BASE_URL=
FCI_MODEL=
