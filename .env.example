GOOGLE_CLOUD_PROJECT=your-project-id
# Gemini 3.8 Flash is served from the global endpoint on Agent Platform (formerly Vertex AI);
# Cloud Run / Firestore stay in asia-northeast1
GOOGLE_CLOUD_LOCATION=global
# google-genai >= 2.x name; GOOGLE_GENAI_USE_VERTEXAI is still read as a legacy alias
GOOGLE_GENAI_USE_ENTERPRISE=true
# quick local test alternative: GEMINI_API_KEY=...
GEMINI_MODEL=gemini-3.5-flash-lite   # text judge + recovery agent (fast); measured in docs/EVAL.md
GEMINI_VISION_MODEL=gemini-3.8-flash  # screenshots / documents
GEMINI_LIVE_MODEL=gemini-3.5-flash-lite
# streaming STT: set after the P0.5 bake-off (gemini-3.5-transcribe-live | chirp_3)
STT_BACKEND=gemini-3.5-transcribe-live
# HMAC key for phone numbers (Secret Manager in production)
HASH_KEY=change-me

# --- Model comparison only (tools/compare_llm.py). The product and the contest entry stay on Gemini. ---
# LLM_BACKEND=fci sends the (masked) text to an OpenAI-compatible endpoint instead of Gemini.
LLM_BACKEND=gemini
OPENAI_API_KEY=
OPENAI_BASE_URL=
FCI_MODEL=

# Verdict log: why each check / live look ended where it did (app/verdict_log.py). Stdout JSON always (Cloud Logging);
# VERDICT_LOG=<path> also appends JSONL for local runs; LOG_TEXT=1 adds the masked text - local evaluation only, never on Cloud Run.
# VERDICT_LOG=backend/eval/logs/local.jsonl
# LOG_TEXT=0
