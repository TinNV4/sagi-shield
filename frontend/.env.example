# URL of the Sagi Shield Python API (Cloud Run), e.g. http://localhost:8080
# Empty -> the app runs on the built-in MockApi and shows a DEMO MODE badge.
# No secrets belong in the frontend: every Gemini call happens in the backend.
VITE_API_BASE=

# Firebase App Check (reCAPTCHA Enterprise), printed by infra/setup_appcheck.ps1. Public values, not secrets.
# Leave empty locally: no token is sent, and the API must then run with APPCHECK=off.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_PROJECT_ID=
# Sign-in popup host (optional): empty -> <VITE_FIREBASE_PROJECT_ID>.firebaseapp.com
VITE_FIREBASE_AUTH_DOMAIN=
VITE_RECAPTCHA_SITE_KEY=
# Guardian push (FCM web push): the public Web Push (VAPID) key from Firebase console > Project settings >
# Cloud Messaging > Web configuration. Empty -> no notifications; the guardian dashboard still polls.
VITE_FIREBASE_VAPID_KEY=
